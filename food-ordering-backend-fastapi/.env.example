# Module 3 skeleton — same variable names as food-ordering-backend/.env.example,
# per the "preserve configuration surface" requirement in the Module 2/3 docs.
# Copy to .env and fill in real values for local development.

# MongoDB
MONGODB_URI=
MONGODB_CONNECTION_STRING=

# JWT
JWT_SECRET_KEY=your_jwt_secret_here

# Frontend / Backend URLs (used by CORS and the Google OAuth redirect, once migrated)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=

# Google OAuth
GOOGLE_ID=
GOOGLE_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Server
PORT=8000
LOG_LEVEL=INFO
